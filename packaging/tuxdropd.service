[Unit]
Description=tuxDrop file sharing daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Resolved from systemd's search path (/usr/local/bin, /usr/bin): the same
# unit serves the packages and a manual install.
ExecStart=tuxdropd
Restart=on-failure

[Install]
WantedBy=graphical-session.target
