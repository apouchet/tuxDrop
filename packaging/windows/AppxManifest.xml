<?xml version="1.0" encoding="utf-8"?>
<!-- Sparse package ("package with external location"): it holds no program, only
     this manifest and the logos, and gives tuxdrop-share.exe, installed next to
     tuxdropd.exe, the identity a Share sheet entry needs. Built and signed by
     scripts/package-windows.ps1, which fills in @VERSION@ and @ARCH@; registered
     by install.ps1 with the install folder as external location. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">
  <!-- Name and Publisher must match packaging/windows/tuxdrop-share.manifest;
       Publisher is the subject of the signing certificate. -->
  <Identity Name="tuxDrop" Publisher="CN=tuxDrop" Version="@VERSION@" ProcessorArchitecture="@ARCH@"/>
  <Properties>
    <DisplayName>tuxDrop</DisplayName>
    <PublisherDisplayName>tuxDrop</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us"/>
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <rescap:Capability Name="unvirtualizedResources"/>
  </Capabilities>
  <Applications>
    <Application Id="tuxDrop" Executable="tuxdrop-share.exe"
      uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <!-- No Start menu entry: install.ps1 adds a shortcut to tuxdropd.exe. -->
      <uap:VisualElements AppListEntry="none" DisplayName="tuxDrop"
        Description="Send files to nearby devices (LocalSend compatible)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"/>
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Send to a nearby device">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType/>
            </uap:SupportedFileTypes>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
